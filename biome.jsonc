{
  "$schema": "https://biomejs.dev/schemas/1.8.2/schema.json",
  "organizeImports": {
    "enabled": false
  },
  "files": {
    // `dist/` is the committed build output: bundled, partly vendored third-party
    // code that no one edits by hand. Linting it drowns the report in thousands of
    // findings nobody can act on. It is checked in so consumers can install this
    // package straight from git, not because it is source.
    "ignore": ["dist"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
